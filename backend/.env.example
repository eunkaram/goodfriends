# AI 커뮤니티 — 환경변수 템플릿. cp .env.example .env 로 시작.

# DB
POSTGRES_PORT=55434
PGBOUNCER_PORT=56434
POSTGRES_PASSWORD=change-me
PGHOST=127.0.0.1
PG_POOL_MAX=4

# Redis
REDIS_PORT=6381
REDIS_PASSWORD=change-me

# 앱
PORT=3010
APP_BASE_URL=http://localhost:3011

# 이메일 (선택) — 없으면 콘솔 폴백
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=

# ── M3 뉴스봇/다이제스트 ──
# LLM (선택) — OpenAI-호환 chat completions. 없으면 결정적 stub 요약이 쓰인다.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# 사이클 스펙(발행 스펙은 운영하며 튜닝 — news-bot.ts 참고)
# NEWS_MAX_PER_CYCLE=5
# NEWS_CYCLE_HOURS=24
# 장애 알림 수신(선택) — RSS/LLM 실패 시 mail. 없으면 콘솔 로그만.
# ADMIN_ALERT_EMAIL=
