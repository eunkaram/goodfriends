# AI 커뮤니티 — 환경변수 템플릿. cp .env.example .env 로 시작.

# DB
POSTGRES_PORT=55434
PGBOUNCER_PORT=56434
POSTGRES_PASSWORD=change-me
PGHOST=127.0.0.1
PG_POOL_MAX=4

# Redis
REDIS_PORT=6381
REDIS_PASSWORD=change-me

# 앱
PORT=3010
APP_BASE_URL=http://localhost:3011

# 이메일 (선택) — 없으면 콘솔 폴백
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=

# 소셜 로그인(선택) — 둘 다 없으면 이메일 가입/로그인만 노출(프론트가 숨김).
# GOOGLE_CLIENT_ID/SECRET: https://console.cloud.google.com/apis/credentials
# GITHUB_CLIENT_ID/SECRET: https://github.com/settings/developers (New OAuth App)
# 콜백 URL은 두 콘솔 다 ${OAUTH_REDIRECT_BASE}/api/auth/{google|github}/callback로 등록.
# OAUTH_REDIRECT_BASE=http://localhost:3010
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── M3 뉴스봇/다이제스트 ──
# LLM (선택) — OpenAI-호환 chat completions. 없으면 결정적 stub 요약이 쓰인다.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# 제공사별 확장 필드(OpenAI 호환 계약 유지용 통로) — vLLM Qwen 계열의 thinking
# 억제 등. 미설정이면 확장 필드 없이 호출(표준 OpenAI 동작).
# 실측: 로컬 vLLM(Qwen3.5)은 /no_think 소프트 스위치를 무시 — 템플릿 kwargs로만
# 억제된다. {"chat_template_kwargs":{"enable_thinking":false}}
# LLM_EXTRA_BODY_JSON=
# 사이클 스펙(발행 스펙은 운영하며 튜닝 — news-bot.ts 참고)
# NEWS_MAX_PER_CYCLE=5
# NEWS_CYCLE_HOURS=24
# 장애 알림 수신(선택) — RSS/LLM 실패 시 mail. 없으면 콘솔 로그만.
# ADMIN_ALERT_EMAIL=
