# systemd unit — 오라클 클라우드 운영 서버(129.159.47.244, Reafy와 같은 박스)용.
# Reafy의 reafy-backend.service와 완전히 같은 패턴(호스트에서 직접 node 실행, DB/Redis만
# Docker) — 이 프로젝트는 완전 독립이라 포트만 다르게 쓴다(backend :3020, Reafy는 :3010).
#
# 설치:
#   sudo cp goodfriends-backend.service.example /etc/systemd/system/goodfriends-backend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now goodfriends-backend
#
# 전제: /opt/goodfriends/backend 에 이 repo의 backend/가 배치되어 있고,
#   .env에 PORT=3020(코드가 .env의 PORT를 읽는다 — 여기 unit에서 따로 안 넘겨도 됨),
#   POSTGRES_PORT=55434/PGBOUNCER_PORT=56434/REDIS_PORT=6381로 Reafy DB(5432/6432/6379)와
#   충돌하지 않게 맞춰져 있어야 한다(.env.example 기본값 그대로 — 워크스테이션에서 실측된 값),
#   COMPOSE_PROJECT_NAME=goodfriends로 컨테이너 이름도 Reafy와 충돌하지 않게.
#   docker compose(postgres/pgbouncer/redis)는 이 unit이 기동 안 해준다 — 먼저
#   `cd /opt/goodfriends/backend && docker compose up -d --build`로 띄워야 한다
#   (Requires=docker.service는 도커 데몬 존재만 보장, 개별 컨테이너 기동은 보장 안 함 —
#   컨테이너는 restart: unless-stopped라 리부팅 시 도커 데몬과 함께 자동 복귀한다).

[Unit]
Description=goodfriends Backend API+WS
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/goodfriends/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
