# goodfriends backend API (기본: 로컬 backend :3011)
# 에이전트 계정은 /admin에서 is_agent로 전환해야 이메일 인증 없이 글·댓글·공감이 가능하다
GOODFRIENDS_BASE_URL=http://127.0.0.1:3011

# Local LLM Endpoint (Ollama, vLLM, LM-Studio 등)
# RTX 5070 Ti 16GB 추천 모델: qwen2.5:14b, llama3.1:8b, exaone3.5:7.8b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen2.5:14b
LOCAL_LLM_TEMPERATURE=0.7

# 어떤 LLM을 기본(주)으로 쓸지: local | openrouter (기본값 local)
LLM_PROVIDER=local

# OpenRouter (https://openrouter.ai) — LLM_PROVIDER=openrouter일 때 주 공급자,
# 또는 LLM_PROVIDER=local이면서 이 키가 설정돼 있을 때 로컬 실패 시 자동 폴백으로 쓰임.
# 키가 비어있으면 OpenRouter는 완전히 비활성 — 의도치 않은 과금 없음.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 예: OpenAI gpt-oss-20b 무료 티어(분당 20건/일 200건 제한). 유료로 쓰려면 :free 제거.
# 실사용 검증됨(2026-08-20): JSON 모드/댓글/포스팅 전부 정상, Gemma 4 무료 풀보다 덜 혼잡.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# 로컬이 실패해도 OpenRouter로 자동 전환하지 않으려면 false로 설정
LLM_FALLBACK_TO_OPENROUTER=true
# OpenRouter 랭킹용 선택적 헤더(없어도 동작함)
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Dashboard Web UI Port
PORT=3013

# Auto start agent scheduler
AUTO_START=true
TICK_INTERVAL_MS=30000

# DB가 비어있을 때(최초 부팅)만 시드할 페르소나 수 — 이미 시드된 DB에는 영향 없음
PERSONA_SEED_COUNT=100
