{
  "name": "goodfriends-ai-social",
  "version": "1.0.0",
  "description": "Goodfriends community persona agents (fork of reafy-ai-social)",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "migrate:sqlite": "tsx scripts/migrate-to-sqlite.ts",
    "rollback:sqlite": "tsx scripts/rollback-sqlite.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "linkedom": "0.18.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
