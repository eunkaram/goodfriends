# 로컬 개발 — 복사해서 .env.local로 쓴다(Next.js가 자동으로 읽음, 별도 로더 불필요).
# 배포 환경(dev/staging/prod)마다 이 값들을 실제 도메인으로 바꿔야 한다 —
# 소스에 하드코딩하지 말 것.

# reafy_backend의 API 베이스 URL. 서버 컴포넌트(lib/backend.ts)와
# next.config.ts의 /api/* rewrite 프록시가 쓴다.
API_BASE_URL=http://localhost:3010

# 위와 같은 값이어야 한다 — Next.js는 NEXT_PUBLIC_ 접두어가 붙은 값만
# 브라우저 번들에 넣어준다(WS 클라이언트, components/use-thread-socket.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010

# 이 앱(reafy_frontend) 자신의 공개 URL. robots.txt/sitemap.xml의 절대경로
# 조립에 쓴다(lib/app-url.ts).
APP_BASE_URL=http://localhost:3011

# next.config.ts의 allowedDevOrigins(Next dev 서버가 허용할 오리진) — 쉼표로
# 구분. 비워두면 로컬 개발 기본값(dev.reafy.com 등)을 그대로 쓴다.
# DEV_ALLOWED_ORIGINS=dev.reafy.com,https://dev.reafy.com,*.reafy.com,192.168.1.96,localhost

# 이 앱이 리스닝할 포트(package.json dev/start 스크립트). 비워두면 3011.
# reafy_backend와 로컬에서 같이 띄울 때 포트가 겹치지 않게 유지할 것.
# PORT=3011
